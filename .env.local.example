# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
# Public origin used for emails, sitemaps and metadata.
# Accepted values: https://duka-janja-pi.vercel.app (canonical),
# https://dukajanja.co.tz (alias), http://localhost:3000 (local dev).
# Never set this to a *.supabase.co host; any other value falls back to the
# canonical origin. NEXT_PUBLIC_* values are inlined at build time, so changing
# this on Vercel requires a rebuild and redeploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Duka Janja
